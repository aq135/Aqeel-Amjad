* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
    text-decoration: none;
    scroll-behavior: smooth;
}

:root {
    --bg-color: #0f172a;
    --second-bg-color: #1e293b;
    --text-color: #f8fafc;
    --main-color: #0ea5e9;
}

body {
    background: var(--bg-color);
    color: var(--text-color);
}

/* Navbar */
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    padding: 20px 10%;
    background: var(--second-bg-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 100;
}

.logo {
    font-size: 24px;
    font-weight: 700;
}

.logo span {
    color: var(--main-color);
}

.navbar ul {
    display: flex;
    list-style: none;
}

.navbar ul li a {
    color: var(--text-color);
    margin-left: 30px;
    font-weight: 500;
    transition: 0.3s;
}

.navbar ul li a:hover {
    color: var(--main-color);
}

/* Sections General */
section {
    min-height: 100vh;
    padding: 100px 10% 50px;
}

.heading {
    text-align: center;
    font-size: 36px;
    margin-bottom: 40px;
}

.heading span {
    color: var(--main-color);
}

/* Hero Section */
.hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.hero-text h3 {
    font-size: 24px;
}

.hero-text h1 {
    font-size: 48px;
    margin: 10px 0;
}

.highlight {
    color: var(--main-color);
}

.hero-text p {
    margin: 20px 0;
    max-width: 500px;
    color: #94a3b8;
    line-height: 1.6;
}

.social-icons a {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 2px solid var(--main-color);
    border-radius: 50%;
    color: var(--main-color);
    margin-right: 15px;
    transition: 0.3s;
}

.social-icons a:hover {
    background: var(--main-color);
    color: var(--bg-color);
}

.btn {
    display: inline-block;
    padding: 10px 25px;
    background: var(--main-color);
    color: var(--bg-color);
    border-radius: 6px;
    font-weight: 600;
    margin-top: 20px;
    transition: 0.3s;
    border: none;
    cursor: pointer;
}

.btn:hover {
    box-shadow: 0 0 15px var(--main-color);
}

.img-box img {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    border: 4px solid var(--main-color);
    object-fit: cover;
}

/* About */
.about {
    background: var(--second-bg-color);
    text-align: center;
}

.about-content p {
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.8;
    color: #94a3b8;
    font-size: 17px;
}

/* Skills */
.skills-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
}

.skill-card {
    background: var(--second-bg-color);
    padding: 25px;
    border-radius: 8px;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: 0.3s;
}

.skill-card i {
    font-size: 36px;
    color: var(--main-color);
    margin-bottom: 12px;
}

.skill-card h3 {
    margin-bottom: 8px;
}

.skill-card p {
    font-size: 13px;
    color: #94a3b8;
}

.skill-card:hover {
    transform: translateY(-5px);
    border-color: var(--main-color);
}

/* Projects */
.projects {
    background: var(--second-bg-color);
}

.projects-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 25px;
}

.project-card {
    background: var(--bg-color);
    padding: 25px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.project-icon i {
    font-size: 30px;
    color: var(--main-color);
    margin-bottom: 15px;
}

.project-card h3 {
    margin-bottom: 10px;
}

.project-card p {
    color: #94a3b8;
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 15px;
}

.tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.tags span {
    background: var(--second-bg-color);
    color: var(--main-color);
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 12px;
}

/* Contact */
.contact-info {
    text-align: center;
    margin-bottom: 30px;
}

.info-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--second-bg-color);
    padding: 12px 25px;
    border-radius: 30px;
    border: 1px solid var(--main-color);
}

.info-item i {
    color: var(--main-color);
}

.info-item a {
    color: var(--text-color);
}

.contact form {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.contact input, .contact textarea {
    padding: 15px;
    background: var(--second-bg-color);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    color: var(--text-color);
    outline: none;
}

.contact input:focus, .contact textarea:focus {
    border-color: var(--main-color);
}

/* Footer */
footer {
    text-align: center;
    padding: 20px;
    background: var(--second-bg-color);
    font-size: 14px;
    color: #94a3b8;
}